; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ira Domini - prototype"
config/description="Stealth horror prototype for the Full Circle jam. Draw chalk circles; the demon cannot cross a closed line."
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameSettings="*res://scripts/game_settings.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
limits/opengl/max_renderable_lights=64
limits/opengl/max_lights_per_object=16
environment/defaults/default_clear_color=Color(0.01, 0.012, 0.025, 1)
mesh_lod/lod_change/threshold_pixels=3.0
